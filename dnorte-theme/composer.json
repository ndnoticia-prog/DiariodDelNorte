{
    "name": "diariodelnorte/dnorte-theme",
    "description": "Tema de presentaci\u00f3n de Diario del Norte (sin l\u00f3gica de negocio).",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "diariodelnorte/dnorte-core": "*",
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../dnorte-core"
        }
    ],
    "autoload": {
        "psr-4": {
            "DNorteTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DNorteTheme\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ],
        "test:integration": "../tools/wp-tests/phpunit9/vendor/bin/phpunit --colors=always -c phpunit-integration.xml.dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
